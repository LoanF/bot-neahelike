# Copier ce fichier en .env et remplir les valeurs (le fichier .env n'est jamais commité).

# Bot Discord : application « Néa Hélikè », commune au site et au bot (même token), onglet Bot.
# Intents « Server Members », « Message Content » et « Presence » activés.
# Ne jamais lancer le bot à deux endroits en même temps avec ce token.
DISCORD_BOT_TOKEN=

# Serveur Néa Hélikè (clic droit → Copier l'identifiant, mode développeur activé)
DISCORD_GUILD_ID=1553450353507176478

# Rôles du serveur, mêmes valeurs que dans le site (ce ne sont pas des secrets).
# Rangs du site : un ou plusieurs ID séparés par des virgules ; un seul rôle de la liste suffit.
# Staff : Conseiller, Technopoios (dev)
DISCORD_ROLE_STAFF=1554037114038001685,1555984043806433422
# Recruteur : Epistate
DISCORD_ROLE_RECRUTEUR=1554039014460358757
# « attente de wl » : candidature validée, débloque les vocaux de whitelist
DISCORD_ROLE_ASPIRANT=1562445946657312828
# « Magistrat (wl) » : vocal réussi et whitelist validée sur le tableau de bord (retire « attente de wl »)
DISCORD_ROLE_HELIKEEN=1554054896712552528

# Adresse publique du site, sans / final (liens vers le portail dans /candidature)
SITE_URL=

# Même base que le site : Supabase → Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.xxxx:motdepasse@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Génération des types (pnpm db:types) : identifiant du projet Supabase.
# La CLI demande une connexion préalable : `pnpm exec supabase login`.
SUPABASE_PROJECT_ID=nwzupjobbdlaabowujdq

# trace, debug, info, warn, error
LOG_LEVEL=info
